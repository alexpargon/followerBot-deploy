# IMPORTANTE: NO uses comillas en los valores. python-dotenv las quita en algunas
# versiones y las preserva en otras. Los espacios se preservan tal cual.
#
#   CORRECTO:    MT5_SERVER=VTMarkets-Live 3
#   INCORRECTO:  MT5_SERVER="VTMarkets-Live 3"

# === MetaTrader 5 ===
MT5_LOGIN=12345678
MT5_PASSWORD=tu_password
MT5_SERVER=VTMarkets-Live 3

# === Telegram ===
TELEGRAM_API_ID=000000
TELEGRAM_API_HASH=abc123...

# === TraderControlEA (native MT5 economic calendar bridge, optional) ===
# When enabled, the followerbot terminal also runs TraderControlEA, which pushes
# the native MT5 economic calendar (and account data) to TraderControlServer.
# Provide the compiled ea/TraderControlEA.ex5 in the deploy repo, set these,
# then run: bot-cli install-ea && bot-cli restart  (see docs/TRADER_CONTROL_EA.md).
TRADERCONTROL_EA_ENABLED=false
TRADERCONTROL_EA_URL=
TRADERCONTROL_EA_KEY=
# Chart symbol the EA is auto-attached to at MT5 startup. Leave empty to reuse
# the terminal's last selected symbol (falls back to EURUSD). Set explicitly if
# your broker uses suffixes, e.g. XAUUSD-VIPc — an invalid symbol means no
# chart opens, and therefore no EA.
TRADERCONTROL_EA_SYMBOL=

# === LIFT Channel ===
LIFT_CHANNEL_ID=0000000000
LIFT_MAGIC=123456
LIFT_SYMBOL=XAUUSD
LIFT_LOT_SIZE=0.01
LIFT_TP_PIPS=20
LIFT_PIP_SIZE=0.1
LIFT_SL_POSITIVE_PIPS=20

# === Maestro Fx Channel ===
MAESTRO_CHANNEL_ID=0000000000
MAESTRO_MAGIC=234567
MAESTRO_SYMBOL=XAUUSD
MAESTRO_LOT_SIZE=0.01
MAESTRO_PIP_SIZE=0.1
MAESTRO_MAX_LAYERS=3
