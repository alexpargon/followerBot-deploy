# IMPORTANTE: NO uses comillas en los valores. python-dotenv las quita en algunas
# versiones y las preserva en otras. Los espacios se preservan tal cual.
#
#   CORRECTO:    MT5_SERVER=VTMarkets-Live 3
#   INCORRECTO:  MT5_SERVER="VTMarkets-Live 3"

# === Entorno ===
BOT_ENV=prod
BOT_INSTANCE_NAME=FollowerBot Production

# === MetaTrader 5 ===
MT5_LOGIN=12345678
MT5_PASSWORD=tu_password
MT5_SERVER=VTMarkets-Live 3

# === Telegram ===
TELEGRAM_API_ID=000000
TELEGRAM_API_HASH=abc123...

# === Mobile control API (optional) ===
# Generate a unique secret, for example: openssl rand -hex 32
# Leave empty to disable the HTTP service completely.
FOLLOWERBOT_CONTROL_API_KEY=
# Bind inside the container. Use 0.0.0.0 only with private-network/TLS access.
FOLLOWERBOT_CONTROL_BIND=127.0.0.1
FOLLOWERBOT_CONTROL_PORT=8787
# Docker host publication. Empty keeps the API private to the container.
# Use 0.0.0.0 for access from the private LAN, then restrict it with the host firewall.
FOLLOWERBOT_CONTROL_PUBLISH_ADDRESS=

# === LIFT Channel ===
LIFT_ENABLED=true
LIFT_CHANNEL_ID=0000000000
LIFT_MAGIC=123456
LIFT_SYMBOL=XAUUSD
LIFT_LOT_SIZE=0.01
LIFT_TP_PIPS=20
LIFT_PIP_SIZE=0.1
LIFT_SL_POSITIVE_PIPS=20
LIFT_SL_ACTIVATION_MARGIN_PIPS=30
LIFT_BASKET_ENABLED=true

# === Maestro Fx Channel ===
MAESTRO_ENABLED=true
MAESTRO_CHANNEL_ID=0000000000
MAESTRO_MAGIC=234567
MAESTRO_SYMBOL=XAUUSD
MAESTRO_LOT_SIZE=0.01
MAESTRO_PIP_SIZE=0.1
MAESTRO_MAX_LAYERS=3
MAESTRO_BASKET_ENABLED=true

# === TrueTrading Channel ===
TRUETRADING_ENABLED=true
TRUETRADING_AUTO_AVG_GOLDEN_RATIO=false
TRUETRADING_USER=your@email.com
TRUETRADING_PASSWORD=your_password
TRUETRADING_CHANNEL_ID=999900001
TRUETRADING_SYMBOL=XAUUSD
TRUETRADING_MAGIC=345678
TRUETRADING_LOT_SIZE=0.01
TRUETRADING_TP_PIPS=30
TRUETRADING_SL_POSITIVE_PIPS=30
TRUETRADING_SL_ACTIVATION_MARGIN_PIPS=30
TRUETRADING_PIP_SIZE=0.1
TRUETRADING_BASKET_ENABLED=true

# === Elite XAU VIP Channel ===
ELITEXAU_ENABLED=true
ELITEXAU_CHANNEL_ID=0000000000
ELITEXAU_MAGIC=567890
ELITEXAU_SYMBOL=XAUUSD
ELITEXAU_LOT_SIZE=0.05
ELITEXAU_PIP_SIZE=0.1
ELITEXAU_BASKET_ENABLED=true

# === Ajustes generales de gestión ===
SL_SAFETY_BUFFER_PIPS=3.0

# Defaults de cesta; cada estrategia admite override <ESTRATEGIA>_BASKET_*.
BASKET_ADAPTIVE=true
BASKET_TRAIL_PIPS=AUTO
BASKET_SPREAD_MULT=2.0
BASKET_ATR_MULT=1.0
BASKET_MIN_TRAIL_PIPS=AUTO
BASKET_MAX_TRAIL_PIPS=AUTO
BASKET_ATR_PERIOD=14
BASKET_NET_LOSS_GUARD=true
BASKET_NET_LOSS_GUARD_PIPS=0
BASKET_MAX_DURATION_SEC=3600

# === Margin Guardian ===
GUARDIAN_ENABLED=true
GUARDIAN_SYMBOL=XAUUSD
GUARDIAN_MAGIC=456789
GUARDIAN_BASE_LOT=0.01
GUARDIAN_HEDGE_LOT=0
GUARDIAN_MAX_HEDGE_LOT=0
GUARDIAN_PIP_SIZE=0.1
GUARDIAN_MARGIN_LEVEL_THRESHOLD=1000.0
GUARDIAN_REARM_MARGIN_LEVEL=1100.0
GUARDIAN_REARM_STEP=100.0
GUARDIAN_SL_PIPS=AUTO
GUARDIAN_LOCK_TRIGGER_PIPS=20
GUARDIAN_LOCK_SL_PIPS=5
GUARDIAN_MAX_HEDGES=0
GUARDIAN_MIN_SECONDS_BETWEEN=5.0
GUARDIAN_MIN_NET_LOTS=0.01
GUARDIAN_STALE_REARM_SECONDS=5.0
GUARDIAN_STATE_FILE=

# === Gestor de operaciones manuales ===
MANUAL_MANAGER_ENABLED=false
MANUAL_SYMBOL=XAUUSD
MANUAL_MAGIC=0
MANUAL_PIP_SIZE=0.1
MANUAL_MANAGE_ANY_NON_RESERVED=false
MANUAL_INITIAL_SL_PIPS=AUTO
MANUAL_BE_TRIGGER_PIPS=AUTO
MANUAL_BE_LOCK_PIPS=AUTO
MANUAL_TRAIL_TRIGGER_PIPS=AUTO
MANUAL_TRAIL_PIPS=AUTO
MANUAL_ADAPTIVE_TRAIL=true
MANUAL_SPREAD_MULT=2.0
MANUAL_ATR_MULT=1.0
MANUAL_MIN_TRAIL_PIPS=8.0
MANUAL_MAX_TRAIL_PIPS=80.0
MANUAL_ATR_PERIOD=14
MANUAL_TP_PIPS=0
