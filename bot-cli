#!/bin/bash
# bot-cli — operaciones comunes sobre followerBot
# Uso: bot-cli <comando> [args]

set -uo pipefail

CONTAINER_NAME="${CONTAINER_NAME:-followerbot}"
APP_DIR="${APP_DIR:-/opt/mi_trading_bot}"
BOT_CONFIG_DIR="${BOT_CONFIG_DIR:-/opt/bot-config}"

usage() {
    cat <<EOF
bot-cli — operaciones comunes sobre followerBot

Uso: bot-cli <comando>

Comandos:
  status              Estado del contenedor, último commit, archivos clave
  logs                Logs del contenedor (docker logs -f)
  bot-logs            Logs del bot Python (tail -f bot.log)
  restart             Reinicia el contenedor (no rebuild)
  pull-and-restart    git pull + restart (fuerza actualización)
  telegram-login      Login interactivo de Telethon (primera vez)
  mt5-shell           Lanza una shell Python interactiva con MT5 disponible
  vnc                 Imprime URL de VNC y la abre si hay xdg-open
  env-edit            Edita /opt/bot-config/.env
  env-show            Muestra .env (enmascara passwords)
  install-ea          Instala TraderControlEA (calendario nativo MT5) en el terminal
  ea-status           Comprueba si TraderControlEA está adjunto y empujando
  doctor              Diagnóstico read-only de una pasada (contenedor, git, EA,
                      heartbeat, errores recientes, disco). Exit!=0 si algo falla.
  rebuild-image       Pull de imagen y restart (tras nueva versión en el registry)
  shell               Shell bash dentro del contenedor como abc
  rootshell           Shell bash dentro del contenedor como root
  help                Esta ayuda

EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
    status)
        echo "=== Container ==="
        docker ps --filter "name=^${CONTAINER_NAME}$" --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
        echo
        echo "=== Repo (último commit) ==="
        cd "$APP_DIR" 2>/dev/null && git log -1 --oneline 2>/dev/null || echo "Repo no clonado"
        echo
        echo "=== Estado del bot ==="
        if [ -f "$BOT_CONFIG_DIR/.env" ]; then
            echo ".env: presente ($(stat -c '%U:%G %a' "$BOT_CONFIG_DIR/.env"))"
        else
            echo ".env: FALTA"
        fi
        if [ -f "$BOT_CONFIG_DIR/session.session" ]; then
            echo "session.session: presente"
        else
            echo "session.session: FALTA (ejecuta bot-cli telegram-login)"
        fi
        if [ -f "$BOT_CONFIG_DIR/trades.db" ]; then
            echo "trades.db: presente"
        else
            echo "trades.db: aún no creado (normal en primer arranque)"
        fi
        ;;

    logs)
        exec docker logs -f --tail 50 "$CONTAINER_NAME"
        ;;

    bot-logs)
        exec tail -f "$BOT_CONFIG_DIR/bot.log"
        ;;

    restart)
        echo "[*] Reiniciando $CONTAINER_NAME..."
        docker restart "$CONTAINER_NAME"
        echo "[OK] Sigue logs con: bot-cli logs"
        ;;

    pull-and-restart)
        cd "$APP_DIR"
        git config --global --add safe.directory "$APP_DIR" 2>/dev/null || true
        git pull --ff-only || { echo "[!] git pull falló"; exit 1; }
        chown -R 911:911 "$APP_DIR"
        docker restart "$CONTAINER_NAME"
        echo "[OK] Pull + restart hecho. Logs: bot-cli logs"
        ;;

    telegram-login)
        echo "[*] Parando servicio s6 del bot..."
        docker exec "$CONTAINER_NAME" s6-svc -d /run/service/followerbot 2>/dev/null || true
        sleep 3
        echo "[*] Lanzando main.py interactivamente para autenticar Telegram."
        echo "    Te pedirá: phone (formato +34xxxxxxxxx) → code (llega por Telegram) → password 2FA si la tienes."
        echo "    Cuando veas 'Listening to N channels' y 'Poll loop started', pulsa Ctrl+C."
        echo
        docker exec -it -u abc -w /config/mi_trading_bot \
            -e XDG_RUNTIME_DIR=/tmp/runtime-abc \
            -e HOME=/config \
            -e WINEDEBUG=-all \
            -e BOT_DATA_DIR=/config/bot-data \
            "$CONTAINER_NAME" \
            wine 'C:\Python311\python.exe' main.py
        echo
        echo "[*] Reactivando servicio s6..."
        chown -R 911:911 "$BOT_CONFIG_DIR"
        docker exec "$CONTAINER_NAME" s6-svc -u /run/service/followerbot
        echo "[OK] Login de Telegram completo. El bot debe estar arrancando solo."
        echo "    Comprueba con: bot-cli logs"
        ;;

    mt5-shell)
        docker exec -it -u abc -w /config/mi_trading_bot \
            -e XDG_RUNTIME_DIR=/tmp/runtime-abc \
            -e HOME=/config \
            -e WINEDEBUG=-all \
            -e BOT_DATA_DIR=/config/bot-data \
            "$CONTAINER_NAME" \
            wine 'C:\Python311\python.exe'
        ;;

    vnc)
        IP=$(hostname -I | awk '{print $1}')
        URL="http://${IP}:3000"
        echo "VNC: $URL"
        if command -v xdg-open >/dev/null; then
            xdg-open "$URL" 2>/dev/null &
        fi
        ;;

    env-edit)
        ${EDITOR:-nano} "$BOT_CONFIG_DIR/.env"
        chown 911:911 "$BOT_CONFIG_DIR/.env"
        chmod 640 "$BOT_CONFIG_DIR/.env"
        echo "[*] Para aplicar cambios: bot-cli restart"
        ;;

    env-show)
        if [ -f "$BOT_CONFIG_DIR/.env" ]; then
            # Enmascara líneas con PASSWORD, HASH, TOKEN, API_ID o cualquier valor sensible
            sed -E 's/(PASSWORD|HASH|TOKEN|API_ID|API_HASH)=.*/\1=***MASKED***/' "$BOT_CONFIG_DIR/.env"
        else
            echo "$BOT_CONFIG_DIR/.env no existe."
            exit 1
        fi
        ;;

    rebuild-image)
        echo "[*] Pull de imagen actualizada..."
        IMAGE=$(docker inspect "$CONTAINER_NAME" --format '{{.Config.Image}}' 2>/dev/null)
        if [ -z "$IMAGE" ]; then
            echo "[!] No se puede determinar imagen del contenedor."
            exit 1
        fi
        docker pull "$IMAGE"
        echo "[*] Reiniciando con imagen nueva..."
        /usr/local/bin/sync_and_deploy.sh
        echo "[OK] Imagen actualizada y contenedor reiniciado."
        ;;

    shell)
        docker exec -it -u abc -w /config/mi_trading_bot \
            -e XDG_RUNTIME_DIR=/tmp/runtime-abc \
            -e HOME=/config \
            "$CONTAINER_NAME" bash
        ;;

    rootshell)
        docker exec -it "$CONTAINER_NAME" bash
        ;;

    install-ea)
        DEPLOY_DIR="${DEPLOY_DIR:-/opt/followerbot-deploy}"
        exec "$DEPLOY_DIR/scripts/install-trader-control-ea.sh"
        ;;

    ea-status)
        MT5_DIR="/config/.wine/drive_c/Program Files/MetaTrader 5"

        echo "=== Ficheros instalados ==="
        docker exec -u abc "$CONTAINER_NAME" sh -c \
            "ls -la '$MT5_DIR/MQL5/Experts/TraderControlEA.ex5' \
                    '$MT5_DIR/MQL5/Presets/TraderControlEA.set' \
                    /config/.wine/drive_c/mt5-startup.ini 2>&1"
        echo
        echo "=== Terminal MT5 ==="
        docker exec "$CONTAINER_NAME" pgrep -af terminal64.exe || echo "terminal64.exe NO está corriendo"
        echo
        echo "=== Heartbeat del EA (se reescribe en cada push, ~15s) ==="
        hb=$(docker exec -u abc "$CONTAINER_NAME" sh -c \
            'find /config/.wine/drive_c/users -name "TraderControlEA_*.dat" -exec stat -c "%Y %n" {} \; 2>/dev/null | sort -n | tail -n 1')
        if [ -z "$hb" ]; then
            echo "SIN heartbeat: el EA nunca se ha registrado. Ejecuta: bot-cli install-ea && bot-cli restart"
            exit 1
        fi
        hb_epoch=${hb%% *}
        hb_path=${hb#* }
        age=$(( $(date +%s) - ${hb_epoch%.*} ))
        echo "fichero: $hb_path"
        echo "edad:    ${age}s"
        docker exec -u abc "$CONTAINER_NAME" cat "$hb_path" 2>/dev/null
        echo
        if [ "$age" -le 60 ]; then
            echo "[OK] El EA está empujando."
        else
            echo "[!] El EA NO está empujando (heartbeat viejo)."
            echo "    Revisa el log de Experts abajo; si está vacío, el EA no está adjunto."
        fi
        echo
        echo "=== Log de Experts (últimas líneas) ==="
        docker exec -u abc "$CONTAINER_NAME" sh -c \
            "cd '$MT5_DIR/MQL5/Logs' 2>/dev/null && iconv -f UTF-16LE -t UTF-8 \"\$(ls -t *.log | head -1)\" 2>/dev/null | tail -25" \
            || echo "(sin MQL5/Logs — ningún Expert ha escrito nunca en este terminal)"
        ;;

    doctor)
        # Diagnóstico read-only. No toca nada. Exit 1 si hay fallos.
        FAIL=0
        warn() { echo "  [!] $*"; }
        fail() { echo "  [X] $*"; FAIL=1; }
        good() { echo "  [OK] $*"; }

        echo "== 1. Contenedor =="
        cstat=$(docker inspect "$CONTAINER_NAME" --format '{{.State.Status}} restarting={{.State.Restarting}} oom={{.State.OOMKilled}}' 2>/dev/null)
        if [ -z "$cstat" ]; then fail "contenedor '$CONTAINER_NAME' no existe"
        elif echo "$cstat" | grep -q 'oom=true'; then fail "última muerte por OOM: $cstat"
        elif echo "$cstat" | grep -q '^running'; then good "$cstat"
        else fail "no está corriendo: $cstat"; fi

        echo "== 2. Repo =="
        head_sha=$(git -C "$APP_DIR" rev-parse --short HEAD 2>/dev/null)
        if [ -z "$head_sha" ]; then fail "repo no clonado o ilegible en $APP_DIR"
        else
            good "HEAD ${head_sha}: $(git -C "$APP_DIR" log -1 --format=%s 2>/dev/null)"
            br=$(git -C "$APP_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null)
            ahead=$(git -C "$APP_DIR" rev-list --count "HEAD..@{u}" 2>/dev/null)
            if [ -n "$ahead" ] && [ "$ahead" != "0" ]; then warn "$ahead commit(s) sin pull en $br"
            elif [ -n "$ahead" ]; then good "al día con origin/$br"; fi
        fi

        echo "== 3. Ficheros de configuración =="
        [ -f "$BOT_CONFIG_DIR/.env" ] && good ".env" || fail ".env falta"
        [ -f "$BOT_CONFIG_DIR/session.session" ] && good "session.session" || fail "session.session falta (bot-cli telegram-login)"
        [ -f "$BOT_CONFIG_DIR/trades.db" ] && good "trades.db" || warn "trades.db aún no existe"

        echo "== 4. Terminal MT5 / EA =="
        docker exec "$CONTAINER_NAME" pgrep -f terminal64.exe >/dev/null 2>&1 \
            && good "terminal64.exe corriendo" || fail "terminal64.exe NO corre"
        hb=$(docker exec -u abc "$CONTAINER_NAME" sh -c \
            'find /config/.wine/drive_c/users -name "TraderControlEA_*.dat" -exec stat -c "%Y" {} \; 2>/dev/null | sort -n | tail -n 1')
        if [ -z "$hb" ]; then warn "EA sin heartbeat (¿install-ea? ¿TRADERCONTROL_EA_ENABLED?)"
        else
            age=$(( $(date +%s) - ${hb%.*} ))
            if [ "$age" -le 60 ]; then good "EA heartbeat ${age}s"
            elif [ "$age" -le 300 ]; then warn "EA heartbeat envejeciendo (${age}s)"
            else fail "EA heartbeat estancado (${age}s)"; fi
        fi

        echo "== 5. Errores recientes del bot (últ. 200 líneas) =="
        if [ -f "$BOT_CONFIG_DIR/bot.log" ]; then
            errs=$(tail -n 200 "$BOT_CONFIG_DIR/bot.log" | grep -Ec 'ERROR|Traceback|CRITICAL' || true)
            if [ "${errs:-0}" -gt 0 ]; then warn "${errs} líneas de error en últimas 200"
            else good "sin errores recientes"; fi
        else
            warn "bot.log no existe todavía"
        fi

        echo "== 6. Disco =="
        disk_use=$(df -P "$BOT_CONFIG_DIR" 2>/dev/null | awk 'NR==2 {print $5}')
        case "${disk_use:-}" in
            ''|*[!0-9%]*) warn "no se pudo leer el uso de disco" ;;
            *) pct=${disk_use%\%}; if [ "$pct" -ge 90 ]; then fail "disco ${disk_use} lleno"
               elif [ "$pct" -ge 80 ]; then warn "disco al ${disk_use}"
               else good "disco ${disk_use}"; fi ;;
        esac

        echo
        if [ "$FAIL" -eq 0 ]; then echo "[OK] doctor: sin fallos"; else echo "[X] doctor: hay fallos (arriba con [X])"; fi
        exit "$FAIL"
        ;;

    help|--help|-h)
        usage
        ;;

    *)
        echo "Comando desconocido: $cmd"
        usage
        exit 1
        ;;
esac
