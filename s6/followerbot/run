#!/usr/bin/with-contenv bash
# Servicio s6: lanza followerBot y se queda en foreground (s6 supervisa).
set -e

CODE_DIR="${BOT_CODE_DIR:-/config/mi_trading_bot}"
DATA_DIR="${BOT_DATA_DIR:-/config/bot-data}"
PY_WIN="${BOT_PYTHON:-C:\\Python311\\python.exe}"

# Asegurar directorios runtime para Wine
mkdir -p /tmp/runtime-abc
chmod 700 /tmp/runtime-abc

# Asegurar permisos del directorio de datos (idempotente)
chown -R abc:abc "$DATA_DIR" 2>/dev/null || true

# ---------------------------------------------------------------------------
# Esperar a que terminal64.exe esté instalado en disco.
# La imagen base descarga e instala MT5 en el primer arranque (1-3 min).
# ---------------------------------------------------------------------------
MT5_EXE="/config/.wine/drive_c/Program Files/MetaTrader 5/terminal64.exe"
MAX_WAIT=300
WAITED=0
while [ ! -f "$MT5_EXE" ] && [ "$WAITED" -lt "$MAX_WAIT" ]; do
    echo "[s6] Esperando a que MT5 termine de instalarse (${WAITED}s/${MAX_WAIT}s)..."
    sleep 5
    WAITED=$((WAITED + 5))
done

if [ ! -f "$MT5_EXE" ]; then
    echo "[s6] ERROR: MT5 no se instaló tras ${MAX_WAIT}s. Saliendo."
    exit 1
fi

# ---------------------------------------------------------------------------
# Asegurar que el terminal MT5 está corriendo en Wine.
# La imagen base intenta iniciarlo con ShellExecuteEx pero falla en algunos
# entornos (Wine devuelve "File not found" para asociaciones .exe).
#
# Además: si existe el startup .ini de TraderControlEA hay que relanzar el
# terminal con /config: aunque la imagen base ya lo haya arrancado, porque la
# base lo lanza SIN configuración y entonces el EA no se adjunta. MT5 sólo
# persiste los perfiles de gráfico en un cierre limpio, y este contenedor se
# mata a lo bruto (s6-svwait timeout), así que el adjuntado manual se pierde
# en cada reinicio. El .ini lo vuelve a adjuntar en cada arranque.
# ---------------------------------------------------------------------------
MT5_STARTUP_INI="/config/.wine/drive_c/mt5-startup.ini"
MT5_ARGS=""
if [ -f "$MT5_STARTUP_INI" ]; then
    MT5_ARGS='/config:C:\mt5-startup.ini'
    if pgrep -f "terminal64.exe" >/dev/null 2>&1; then
        echo "[s6] Startup .ini presente — relanzando MT5 con configuración..."
        pkill -TERM -f "terminal64.exe" 2>/dev/null || true
        WAITED=0
        while pgrep -f "terminal64.exe" >/dev/null 2>&1 && [ "$WAITED" -lt 20 ]; do
            sleep 1
            WAITED=$((WAITED + 1))
        done
        pkill -KILL -f "terminal64.exe" 2>/dev/null || true
        sleep 2
    fi
fi

if ! pgrep -f "terminal64.exe" >/dev/null 2>&1; then
    echo "[s6] Iniciando terminal64.exe ${MT5_ARGS:-(sin configuración)}..."
    s6-setuidgid abc \
        env HOME=/config WINEPREFIX=/config/.wine WINEDEBUG=-all \
            XDG_RUNTIME_DIR=/tmp/runtime-abc DISPLAY=:0 \
        wine "$MT5_EXE" $MT5_ARGS &
    # Dar tiempo al terminal para cargar antes de que el bot intente conectar.
    # mt5_connection.py también reintenta, así que 30s es suficiente margen inicial.
    sleep 30
else
    echo "[s6] Terminal MT5 ya está corriendo."
    sleep 5
fi

echo "[s6] Lanzando followerBot con Python 3.11 embeddable"

cd "$CODE_DIR"

exec s6-setuidgid abc \
    env \
        XDG_RUNTIME_DIR=/tmp/runtime-abc \
        HOME=/config \
        WINEPREFIX=/config/.wine \
        WINEDEBUG=-all \
        DISPLAY=:0 \
    wine "$PY_WIN" main.py
