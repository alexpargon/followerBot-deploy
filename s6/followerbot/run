#!/usr/bin/with-contenv bash
# Servicio s6: lanza followerBot y se queda en foreground.
set -e

cd "${BOT_CODE_DIR:-/config/mi_trading_bot}"

# Asegurar directorios runtime necesarios para Wine
mkdir -p /tmp/runtime-abc
chmod 700 /tmp/runtime-abc

# Esperar a que MT5 y el wineprefix estén listos
sleep 10

# Asegurar permisos del directorio de datos
chown -R abc:abc "${BOT_DATA_DIR:-/config/bot-data}" 2>/dev/null || true

echo "[s6] Lanzando followerBot con Python 3.11 embeddable"

exec s6-setuidgid abc \
    env XDG_RUNTIME_DIR=/tmp/runtime-abc HOME=/config WINEDEBUG=-all \
    wine "${BOT_PYTHON:-C:\\Python311\\python.exe}" main.py
