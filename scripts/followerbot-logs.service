[Unit]
Description=followerBot read-only log server (day-bucketed bot.log/audit_log/trades.db over HTTP+JSON)
After=network.target

[Service]
Type=simple
# LOG_SERVER_TOKEN must be set here (or via an EnvironmentFile) -- the
# server refuses to start without it. Generate one with:
#   openssl rand -hex 32
Environment=BOT_CONFIG_DIR=/opt/bot-config
Environment=APP_DIR=/opt/mi_trading_bot
Environment=LOG_SERVER_PORT=8765
EnvironmentFile=/etc/followerbot-logs.env
ExecStart=/usr/bin/python3 /opt/followerbot-deploy/scripts/log_server.py
Restart=on-failure
RestartSec=5
User=911
Group=911
# Read-only exposure by design: the process itself never writes anywhere
# (see log_server.py), and User=911 already can't write outside paths it
# owns -- that's the real protection. NoNewPrivileges is kept as cheap
# extra hardening. ProtectSystem=strict + ReadOnlyPaths= (previously set
# here) additionally sandboxed the filesystem via a mount namespace, which
# broke sqlite3's ability to open trades.db ("unable to open database
# file") even though plain file reads (bot.log, audit_log.jsonl) worked
# fine through the same mount -- likely an LXC-nested-namespace
# interaction. Not worth the fragility for the marginal extra protection
# on an already-unprivileged, read-only service.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
